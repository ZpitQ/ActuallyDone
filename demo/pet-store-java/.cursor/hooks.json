{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 -m actuallydone hook mark-dirty",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 -m actuallydone hook mark-dirty",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 -m actuallydone hook gate-guard",
        "timeout": 180,
        "loop_limit": 3,
        "failClosed": false
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "python3 -m actuallydone hook mark-dirty",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "python3 -m actuallydone hook mark-dirty",
        "timeout": 10,
        "matcher": "Write|StrReplace|Edit|TabWrite"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 -m actuallydone hook commit-guard",
        "timeout": 30,
        "matcher": "git\\s+commit",
        "failClosed": true
      }
    ]
  }
}
