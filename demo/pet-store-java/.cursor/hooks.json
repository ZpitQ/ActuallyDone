{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 -m actuallydone hook mark-dirty",
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 -m actuallydone hook mark-dirty",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python3 -m actuallydone hook gate-guard",
        "timeout": 120,
        "loop_limit": 3,
        "failClosed": false
      }
    ]
  }
}
